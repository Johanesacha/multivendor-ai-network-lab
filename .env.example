# multivendor-ai-network-lab — environment template
# Copy to .env (gitignored) and fill in. NEVER commit real secrets — this repo is public.

# ─────────────────────────────────────────────────────────────────────────────
# API security (src/app.py Flask backend)
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret required by every privileged/mutating endpoint (/api/run,
# /api/remediate, /api/chaos, /api/ai-command, and all POST/PUT/PATCH/DELETE
# routes). Clients must send it as the `X-API-Key` request header.
# FAIL-CLOSED: if unset, those endpoints return HTTP 503 — never allow-by-default.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MVLAB_API_KEY=

# Bind address for the Flask backend. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY to deliberately expose the privileged API on all interfaces,
# and only together with a strong MVLAB_API_KEY and controlled network access.
MVLAB_HOST=127.0.0.1

# TCP port for the Flask backend (default 5757).
DCN_PORT=5757

# Comma-separated list of allowed CORS origins for /api/* (default is the local
# dashboard origins). The dashboard is served same-origin, so '*' is never needed.
MVLAB_CORS_ORIGINS=http://localhost:5757,http://127.0.0.1:5757

# Optional override for the repo-root anchor used to resolve in-repo assets
# (inventory, demo, network-lab scripts, audit log). Leave unset in normal use.
# MVLAB_REPO_ROOT=

# ─────────────────────────────────────────────────────────────────────────────
# FRR lab CLI proxy (network-lab/cli_proxy.py)
# ─────────────────────────────────────────────────────────────────────────────
# HTTP Basic password (user=admin) for the vtysh command proxy. REQUIRED —
# the proxy refuses to start (fail-closed) if this is unset.
CLI_PROXY_PASSWORD=
# Bind address (default 127.0.0.1). Set to the mgmt IP / 0.0.0.0 to expose.
CLI_PROXY_HOST=127.0.0.1
CLI_PROXY_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# SSH / device access (src/app.py)
# ─────────────────────────────────────────────────────────────────────────────
# FRR lab SSH key path (default: <repo>/network-lab/ssh-keys/lab_key).
# DCN_FRR_SSH_KEY=
# Production SSH key file (when DCN_SSH_MODE=key).
# DCN_SSH_KEY=
DCN_SSH_MODE=pkcs11
# Harden these in any non-laptop deployment:
DCN_SSH_STRICT_HOST_KEY=false
DCN_VERIFY_SSL=false
# Optional FRR lab container password (fails closed when unset).
FRR_DEFAULT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Optional inventory sources (off by default; CSV files are not in this repo)
# ─────────────────────────────────────────────────────────────────────────────
# DCN_SECURECRT_CSV=
# DCN_NETBOX_CSV=

# ─────────────────────────────────────────────────────────────────────────────
# LLM / integrations (optional)
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# LLM_ENABLED=false
# LLM_PROVIDER=
# LLM_MODEL=
# OLLAMA_URL=http://localhost:11434
# LIBRENMS_URL=
# LIBRENMS_TOKEN=
# INFLUXDB_URL=
# INFLUXDB_TOKEN=
